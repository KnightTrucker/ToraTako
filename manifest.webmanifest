{
  "name": "ToraTako",
  "short_name": "ToraTako",
  "description": "Web app / PWA per tachigrafo VDO DTCO 4.1x",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b0b03",
  "theme_color": "#b85a14",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}